.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment / secrets
.env
.env.*
!.env.example

# Node / Next.js
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo
coverage/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Local data — your paper account lives here, never commit it (top-level only, so it does
# not also swallow lib/parlay/data which holds the tracked correlations file)
/data/

# Agent workspace: plans, logs, audit reports, and regenerable distillation datasets
# (Retrosheet downloads + harvested JSONL; rebuild with scripts/distill/*.py). The
# aggregated lib/parlay/data/mlb-correlations.json IS tracked. Root-anchored: git matches
# ignore patterns case-insensitively on macOS, so a bare "Parlay/" would also swallow
# lib/parlay and app/api/parlay.
/Parlay/

# Local agent/tooling config (machine-specific, may reference local secrets)
.mcp.json
.claude/
.agents/
skills-lock.json

# Internal working notes (not for publication)
handoff.md
handoffnotes.md
UIreadme.md
bug_maybe.md
.vercel
.env*
